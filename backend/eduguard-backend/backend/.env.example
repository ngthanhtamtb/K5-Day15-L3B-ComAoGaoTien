# Environment Configuration
ENVIRONMENT=development
DEBUG=False

# Database: SQLite for dev/test (default); PostgreSQL in prod:
#   DATABASE_URL=postgresql://user:password@localhost/smartppt
# Existing PostgreSQL DB from RAGslides: ALTER TABLE users ADD COLUMN role VARCHAR DEFAULT 'giang_vien';
DATABASE_URL=sqlite:///./data/eduguard.db

# Security Keys
SECRET_KEY=your-secret-key-here-change-in-production
FERNET_KEY=your-base64-encoded-fernet-key-here

# API Keys
GEMINI_API_KEY=your-gemini-api-key-here

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini API Configuration
PROMPT_TEMPERATURE=0.3
PROMPT_TOP_K=1
PROMPT_TOP_P=0.9
PROMPT_MAX_OUTPUT_TOKENS=25000
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# Legacy remote extractor (sends the uploaded file to that server). Off by default:
# documents are parsed locally. Only used with EDU_PDF_ENGINE=remote.
EXTRACT_DOC_API_URL=

# File Upload Settings
MAX_FILE_SIZE=10485760
TEMPLATE_DIR=data/templates
UPLOAD_TEMPLATES_DIR=data/uploads/templates
UPLOAD_PAGE_DIR=data/uploads/pages
IMAGES_DIR=data/images/templates

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ===== EduGuard extensions =====
EDU_DATA_DIR=data/edu
EDU_PUBLIC_BASE_URL=http://localhost:8077
EDU_MAX_UPLOAD_MB=50
EDU_PDF_ENGINE=local           # local (PyMuPDF/python-pptx) | docling | auto | remote
EDU_OCR_ENABLED=false          # OCR scanned PDF pages via the "vision" LLM route
EDU_IMAGE_CAPTIONS=false       # describe figures via the "vision" route (makes images searchable)

# ===== LLM providers — routing per task in config/llm.yaml (provider without a key is skipped)
LLM_ROUTES_FILE=config/llm.yaml
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEYS=                 # comma-separated, rotated on 429
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
# GEMINI_API_KEY above is shared with the RAGslides routes

# Quiz engine: llm (router, task "quiz") | zentus (external BE_Zentus function, falls back to llm)
QUIZ_ENGINE=llm
QUIZ_MODEL=gemini-2.5-flash    # only for legacy RAGslides Gemini paths

# ===== Users & plans (framework; nothing is blocked while BILLING_ENFORCE=false)
BILLING_ENFORCE=false
PLANS_FILE=config/plans.yaml
ADMIN_EMAILS=admin@smartppt.com
ZENTUS_PATH=E:/Python_Project/VinAI_Lab/BE_Zentus
ZENTUS_GENERATE_FN=            # e.g. app.services.quiz:generate_quiz
ZENTUS_EVALUATE_FN=

# Voice (TTS). "silent" works without any API (for testing the pipeline)
TTS_PROVIDER=silent            # silent | http
TTS_API_URL=
TTS_API_KEY=
TTS_API_KEY_HEADER=Authorization
TTS_API_KEY_PREFIX=Bearer 
TTS_REQUEST_TEMPLATE={"text": "{text}", "voice": "{voice}", "speed": {speed}}
TTS_RESPONSE_TYPE=binary       # binary | json_base64 | json_url
TTS_RESPONSE_FIELD=audio
TTS_AUDIO_EXT=mp3
TTS_DEFAULT_VOICE=default
TTS_MAX_CHARS=1500             # per request; longer text is split at sentence boundaries
# Job-style API (submit -> poll -> fetch): TTS_PROVIDER=http + TTS_MODE=job
TTS_MODE=sync                  # sync | job
TTS_SUBMIT_URL=
TTS_POLL_URL=                  # e.g. https://api.example/tts/jobs/{job_id}
TTS_JOB_ID_FIELD=job_id
TTS_STATUS_FIELD=status
TTS_DONE_VALUES=done,completed,succeeded,success
TTS_FAILED_VALUES=failed,error,cancelled
TTS_DURATION_FIELD=            # dotted path if the API returns the duration
TTS_TIMINGS_FIELD=             # dotted path if the API returns word/sentence timings
TTS_POLL_INTERVAL=1.0
TTS_POLL_MAX_INTERVAL=8.0
TTS_POLL_MAX_WAIT=300
# Limits + price: fill from the provider's docs. Price 0 = unknown -> estimates show no cost.
TTS_RPM=60
TTS_CONCURRENCY=2
TTS_MAX_RETRIES=3
TTS_PRICE_UNIT=char            # char | second | request
TTS_PRICE_PER_UNIT=0
TTS_PRICE_CURRENCY=VND
TTS_CHARS_PER_SECOND=14        # used only for duration estimates before generating
